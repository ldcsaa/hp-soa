<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>org.hpsocket</groupId>
	<artifactId>hp-soa-parent</artifactId>
	<name>hp-soa</name>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>

	<url>http://maven.apache.org</url>

	<properties>
		<hp.soa.version>0.0.1-SNAPSHOT</hp.soa.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<maven.compiler.source>11</maven.compiler.source>
		<maven.compiler.target>11</maven.compiler.target>
		<build.timestamp>${maven.build.timestamp}</build.timestamp>
		<maven.build.timestamp.format>yyyyMMddHHmmss</maven.build.timestamp.format>
		<maven.surefire.conf.forkCount>0</maven.surefire.conf.forkCount>
		<maven.surefire.conf.reuseForks>true</maven.surefire.conf.reuseForks>
		<maven.surefire.conf.argLine>${env.MAVEN_FORK_JVM_ARGS}</maven.surefire.conf.argLine>
	</properties>

	<modules>
		<module>hp-soa-dependencies</module>
		<module>hp-soa-framework</module>
		<module>hp-soa-starter</module>
	</modules>

	<repositories>
		<repository>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
			<id>local-snapshots</id>
			<name>Local Snapshots</name>
			<url>http://nexus.myserver.com:8081/repository/maven-snapshots</url>
		</repository>

		<repository>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
			<id>local-thirdparty</id>
			<name>Local 3rd-party</name>
			<url>http://nexus.myserver.com:8081/repository/maven-thirdparty</url>
		</repository>

		<repository>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
			<id>local-releases</id>
			<name>Local Releases</name>
			<url>http://nexus.myserver.com:8081/repository/maven-releases</url>
		</repository>

		<repository>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
			<id>alimaven</id>
			<name>aliyun maven</name>
			<url>http://maven.aliyun.com/nexus/content/groups/public/</url>
		</repository>

		<repository>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
			<id>central</id>
			<name>Maven Repository Switchboard</name>
			<url>http://repo1.maven.org/maven2</url>
		</repository>

		<repository>
			<id>JBoss repository</id>
			<url>http://repository.jboss.com/maven2/</url>
		</repository>

		<repository>
			<id>JBoss repository public</id>
			<url>http://repository.jboss.org/nexus/content/groups/public/</url>
		</repository>
	</repositories>

	<distributionManagement>
		<repository>
			<id>local-releases</id>
			<name>Local Nexus Releases Repository</name>
			<url>http://nexus.myserver.com:8081/repository/maven-releases/</url>
		</repository>
		<snapshotRepository>
			<id>local-snapshots</id>
			<name>Local Nexus Snapshots Repository</name>
			<url>http://nexus.myserver.com:8081/repository/maven-snapshots/</url>
		</snapshotRepository>
	</distributionManagement>

</project>
