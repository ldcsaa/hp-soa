<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:c="http://www.springframework.org/schema/c"
       xmlns:p="http://www.springframework.org/schema/p"
       xmlns:cache="http://www.springframework.org/schema/cache"
       xmlns="http://www.springframework.org/schema/beans"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
		http://www.springframework.org/schema/beans/spring-beans.xsd
		http://www.springframework.org/schema/cache http://www.springframework.org/schema/cache/spring-cache.xsd">

	<!-- default cache manager -->
	
	<bean id="stringKeyGenerator" class="com.lcb.soa.misc.cache.StringKeyGenerator"/>
	<cache:annotation-driven cache-manager="redisCacheManager" key-generator="stringKeyGenerator" order="-100"/>

	<!-- redis connection factories -->

    <bean
            id="jedisPoolConfig"
            class="redis.clients.jedis.JedisPoolConfig"
            p:maxTotal="${app.redis.pool.maxTotal}"
            p:maxIdle="${app.redis.pool.maxIdle}"
            p:maxWaitMillis="${app.redis.pool.maxWaitMillis}"
            p:testOnBorrow="${app.redis.pool.testOnBorrow}"
    />

    <bean id="jedisConnFactory" class="org.springframework.data.redis.connection.jedis.JedisConnectionFactory"
          p:hostName="${app.redis.server}"
          p:port="${app.redis.port}"
          p:timeout="${app.redis.timeout:2000}"
          p:database="${app.redis.database:0}"
          p:pool-config-ref="jedisPoolConfig"
    />

    <bean id="jedisCacheConnFactory" class="org.springframework.data.redis.connection.jedis.JedisConnectionFactory"
          p:hostName="${app.redis.cache.server}"
          p:port="${app.redis.cache.port}"
          p:timeout="${app.redis.cache.timeout:2000}"
          p:database="${app.redis.cache.database:0}"
          p:pool-config-ref="jedisPoolConfig"
    />

	<!-- redis templates -->

    <bean id="redisTemplate"
          class="org.springframework.data.redis.core.RedisTemplate"
          p:connection-factory-ref="jedisConnFactory">
        <property name="keySerializer">
            <bean class="org.springframework.data.redis.serializer.StringRedisSerializer"/>
        </property>
        <property name="hashKeySerializer">
            <bean class="org.springframework.data.redis.serializer.StringRedisSerializer"/>
        </property>
    </bean>

    <bean id="redisStringTemplate"
          class="org.springframework.data.redis.core.RedisTemplate"
          p:connection-factory-ref="jedisConnFactory">
        <property name="keySerializer">
            <bean class="org.springframework.data.redis.serializer.StringRedisSerializer"/>
        </property>
        <property name="hashKeySerializer">
            <bean class="org.springframework.data.redis.serializer.StringRedisSerializer"/>
        </property>
        <property name="valueSerializer">
            <bean class="org.springframework.data.redis.serializer.StringRedisSerializer"/>
        </property>
        <property name="hashValueSerializer">
            <bean class="org.springframework.data.redis.serializer.StringRedisSerializer"/>
        </property>
    </bean>

    <bean id="redisCacheTemplate"
          class="org.springframework.data.redis.core.RedisTemplate"
          p:connection-factory-ref="jedisCacheConnFactory">
        <property name="keySerializer">
            <bean class="org.springframework.data.redis.serializer.StringRedisSerializer"/>
        </property>
        <property name="valueSerializer">
            <bean class="com.lcb.soa.misc.cache.KryoNotNullRedisSerializer"/>
        </property>
        <property name="hashKeySerializer">
            <bean class="org.springframework.data.redis.serializer.StringRedisSerializer"/>
        </property>
        <property name="hashValueSerializer">
            <bean class="com.lcb.soa.misc.cache.KryoNotNullRedisSerializer"/>
        </property>
    </bean>

    <bean id="nullSupportedRedisUnflushableCacheTemplate"
          class="org.springframework.data.redis.core.RedisTemplate"
          p:connection-factory-ref="jedisConnFactory">
        <property name="keySerializer">
            <bean class="org.springframework.data.redis.serializer.StringRedisSerializer"/>
        </property>
        <property name="valueSerializer">
            <bean class="com.lcb.soa.misc.cache.KryoRedisSerializer"/>
        </property>
        <property name="hashKeySerializer">
            <bean class="org.springframework.data.redis.serializer.StringRedisSerializer"/>
        </property>
        <property name="hashValueSerializer">
            <bean class="com.lcb.soa.misc.cache.KryoRedisSerializer"/>
        </property>
    </bean>

    <bean id="nullSupportedRedisFlushableCacheTemplate"
          class="org.springframework.data.redis.core.RedisTemplate"
          p:connection-factory-ref="jedisCacheConnFactory">
        <property name="keySerializer">
            <bean class="org.springframework.data.redis.serializer.StringRedisSerializer"/>
        </property>
        <property name="valueSerializer">
            <bean class="com.lcb.soa.misc.cache.KryoRedisSerializer"/>
        </property>
        <property name="hashKeySerializer">
            <bean class="org.springframework.data.redis.serializer.StringRedisSerializer"/>
        </property>
        <property name="hashValueSerializer">
            <bean class="com.lcb.soa.misc.cache.KryoRedisSerializer"/>
        </property>
    </bean>

    <bean id="genericFastJsonCacheTemplate"
          class="org.springframework.data.redis.core.RedisTemplate"
          p:connection-factory-ref="jedisConnFactory">
        <property name="keySerializer">
            <bean class="org.springframework.data.redis.serializer.StringRedisSerializer"/>
        </property>
        <property name="valueSerializer">
            <bean class="com.alibaba.fastjson.support.spring.GenericFastJsonRedisSerializer"/>
        </property>
        <property name="hashKeySerializer">
            <bean class="org.springframework.data.redis.serializer.StringRedisSerializer"/>
        </property>
        <property name="hashValueSerializer">
            <bean class="com.alibaba.fastjson.support.spring.GenericFastJsonRedisSerializer"/>
        </property>
    </bean>

    <bean id="genericJackson2JsonCacheTemplate"
          class="org.springframework.data.redis.core.RedisTemplate"
          p:connection-factory-ref="jedisConnFactory">
        <property name="keySerializer">
            <bean class="org.springframework.data.redis.serializer.StringRedisSerializer"/>
        </property>
        <property name="valueSerializer">
            <bean class="org.springframework.data.redis.serializer.GenericJackson2JsonRedisSerializer"/>
        </property>
        <property name="hashKeySerializer">
            <bean class="org.springframework.data.redis.serializer.StringRedisSerializer"/>
        </property>
        <property name="hashValueSerializer">
            <bean class="org.springframework.data.redis.serializer.GenericJackson2JsonRedisSerializer"/>
        </property>
    </bean>

	<!-- redis cache manager -->
	
    <bean
        id="redisCacheManager"
        class="com.lcb.soa.misc.cache.RedisCacheUtil"
        factory-method="createRedisCacheManager"
        c:allowInFlightCacheCreation="true"
        c:connectionFactory-ref="jedisCacheConnFactory">
        <constructor-arg name="defaultCacheConfiguration">
			<bean class="com.lcb.soa.misc.cache.RedisCacheUtil" factory-method="createRedisCacheConfiguration">
				<constructor-arg name="ttlSeconds" value="3600"/>
			</bean>
        </constructor-arg>
        <constructor-arg name="initialCacheConfigurations">
            <map>
                <entry key="default">
					<bean class="com.lcb.soa.misc.cache.RedisCacheUtil" factory-method="createRedisCacheConfiguration">
						<constructor-arg name="ttlSeconds" value="3600"/>
					</bean>
                </entry>
                <entry key="tenSecondsTerm">
					<bean class="com.lcb.soa.misc.cache.RedisCacheUtil" factory-method="createRedisCacheConfiguration">
						<constructor-arg name="ttlSeconds" value="10"/>
					</bean>
                </entry>
                <entry key="minuteTerm">
					<bean class="com.lcb.soa.misc.cache.RedisCacheUtil" factory-method="createRedisCacheConfiguration">
						<constructor-arg name="ttlSeconds" value="60"/>
					</bean>
                </entry>
                <entry key="fiveMinuteTerm">
					<bean class="com.lcb.soa.misc.cache.RedisCacheUtil" factory-method="createRedisCacheConfiguration">
						<constructor-arg name="ttlSeconds" value="300"/>
					</bean>
                </entry>
                <entry key="hourTerm">
					<bean class="com.lcb.soa.misc.cache.RedisCacheUtil" factory-method="createRedisCacheConfiguration">
						<constructor-arg name="ttlSeconds" value="3600"/>
					</bean>
                </entry>
                <entry key="dayTerm">
					<bean class="com.lcb.soa.misc.cache.RedisCacheUtil" factory-method="createRedisCacheConfiguration">
						<constructor-arg name="ttlSeconds" value="86400"/>
					</bean>
                </entry>
                <entry key="monthTerm">
					<bean class="com.lcb.soa.misc.cache.RedisCacheUtil" factory-method="createRedisCacheConfiguration">
						<constructor-arg name="ttlSeconds" value="2592000"/>
					</bean>
                </entry>
            </map>
        </constructor-arg>
    </bean>
</beans>