<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:dubbo="http://dubbo.apache.org/schema/dubbo"
       xmlns="http://www.springframework.org/schema/beans"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="	http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
       						http://dubbo.apache.org/schema/dubbo http://dubbo.apache.org/schema/dubbo/dubbo.xsd
       						http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd">

    <!-- Dubbo 服务自动扫描包路径 -->
    <dubbo:annotation package="${hp.soa.web.component-scan.base-package}"/>

    <!-- 应用程序基本信息 -->
    <dubbo:application name="${hp.soa.web.app.name}" version="${hp.soa.web.app.version}" owner="${hp.soa.web.app.owner:}" organization="${hp.soa.web.app.organization:}"/>

    <!-- 提供者：关闭 exception 拦截器，启动 mdc 和 tracing 拦截器 -->
    <dubbo:provider delay="-1" filter="mdc" validation="${dubbo.provider.validation:false}"/>
    <!-- 消费者：启动 mdc 和 tracing 拦截器，配置是否开启客户端参数验证 -->
    <dubbo:consumer filter="mdc" validation="${dubbo.consumer.validation:false}"/>
    <!-- 注册中心：配置注册中心缓存文件路径 -->
    <dubbo:registry file="/data/dubbo/.cache/dubbo-registry_${hp.soa.web.app.name}.properties"/>

    <!-- - - - - - - - - - - 应用程序私有配置 - - - - - - - - - - -->

    <!-- 导入 dubbo 接口文件-->

    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - -->
</beans>